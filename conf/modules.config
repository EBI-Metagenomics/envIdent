/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    withName: BBMAP_REFORMAT_STANDARDISE {
        ext.args = 'allowidenticalnames=t trimreaddescription=t'
        ext.paired_args = 'addslash=t spaceslash=t verifypaired=f'
        ext.interleaved_args = 'verifyinterleaved=t'
    }

    withName: SEQFU_CHECK {
        publishDir = [
            [
                path: { "${params.outdir}/${meta.id}/qc/" },
                mode: params.publish_dir_mode,
                failOnError: true,
                pattern: "*.tsv",
                saveAs: {"${meta.id}_seqfu.tsv"}
            ]
        ]
    }

    withName: FASTQSUFFIXHEADERCHECK {
        publishDir = [
            [
                path: { "${params.outdir}/${meta.id}/qc/" },
                mode: params.publish_dir_mode,
                failOnError: true,
                pattern: "*.json"
            ]
        ]
    }

    // Keep the second QC stage separate from the initial QC reports.
    withName: 'ENVIDENT:READS_QC_BEFOREHMM:SEQFU_CHECK' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/qc/" },
            mode: params.publish_dir_mode,
            failOnError: true,
            pattern: '*.tsv',
            saveAs: { "${meta.id}_beforehmm_seqfu.tsv" }
        ]
    }

    withName: 'ENVIDENT:READS_QC_BEFOREHMM:FASTQSUFFIXHEADERCHECK' {
        ext.prefix = { "${meta.id}_beforehmm" }
    }

    withName: "ENVIDENT:READS_QC_BEFOREHMM:FASTP" {
        ext.prefix = { "${meta.id}_beforehmm" }
    }
    
    withName: SEQTK_SEQ {
        ext.args = '-a'
    }

    withName: "ENVIDENT:READS_QC:FASTP" {
        ext.prefix = { "${meta.id}_initial" }
        ext.args = [
            '--cut_front_window_size 1',   // Equivalent of Trimmomatic LEADING window size
            '--cut_tail_window_size 1',    // Equivalent of Trimmomatic TRAILING window size
            '--cut_front 3',               // Equivalent of Trimmomatic LEADING quality threshold (3)
            '--cut_tail 3',                // Equivalent of Trimmomatic TRAILING quality threshold (3)
            '--cut_right',                 // Equivalent of Trimmomatic SLIDINGWINDOW
            '--cut_right_window_size 4',   // Equivalent of Trimmomatic SLIDINGWINDOW window size (4)
            '--cut_right_mean_quality 15', // Equivalent of Trimmomatic SLIDINGWINDOW mean quality (15)
            '-l 100'                       // Filter out reads smaller than 100 bases
        ].join(' ');

        publishDir = [
            [
                path: { "${params.outdir}/${meta.id}/qc/" },
                mode: params.publish_dir_mode,
                failOnError: true,
                pattern: '*.fastp.json'
            ]
        ]
    }

    withName: FASTQC {
        ext.args = '--quiet'
    }

    withName: PREP_CUTADAPT_PRIMERS {
        publishDir = [
            [
                path: { "${params.outdir}/${meta.id}/primer-identification/" },
                mode: params.publish_dir_mode,
                failOnError: true,
                pattern: "*.fasta"
            ]
        ]
    }

    withName: EXTRACT_CUTADAPT_PRIMERS {
        publishDir = [
            [
                path: { "${params.outdir}/${meta.id}/primer-identification/" },
                mode: params.publish_dir_mode,
                failOnError: true,
                pattern: "*.fasta"
            ]
        ]
    }

    withName: STD_PRIMER_FLAG {
        ext.args = "-l 75 -e 0.2"
    }

     withName: CUTADAPT {
        publishDir = [
            [
                path: { "${params.outdir}/${meta.id}/primer-identification/" },
                mode: params.publish_dir_mode,
                failOnError: true,
                pattern: "{*.json,*_summ.tsv}"
            ]
        ]
        ext.args = "-e 0.2"
    }

    withName: HMMER_HMMSEARCH {
        ext.args = "--incE 0.01 --incdomE 0.01 -E 0.1 --domE 0.1"
    }

    withName: COMBINEHMMSEARCHTBL {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/hmmsearch-COI/" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if(filename.contains('.domtbl')){
                    return "${meta.id}_Pfam-A.domtbl"
                }
            },
        ]
    }

    withName: PARSEHMMSEARCHCOVERAGE {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/hmmsearch-COI/" },
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                if(filename.contains('.tsv')){
                    return "${meta.id}_Pfam-A.txt"
                }
            },
        ]
    }

    withName: SEQKIT_TRANSLATE {
        ext.args = "--append-frame --allow-unknown-codon --frame 6 --out-subseqs --min-len 15"
    }

    withName: DADA2 {
        publishDir = [
            [
                path: { "${params.outdir}/${meta.id}/qc/" },
                mode: params.publish_dir_mode,
                failOnError: true,
                pattern: "*dada2_errors.txt"
            ],
            [
                path: { "${params.outdir}/${meta.id}/asv/" },
                mode: params.publish_dir_mode,
                failOnError: true,
                pattern: "*dada2_stats.tsv"
            ],
            [
                path: { "${params.outdir}/${meta.id}/asv/" },
                mode: params.publish_dir_mode,
                failOnError: true,
                pattern: "*_asvs.fasta"
            ]
        ]
    }

    withName: 'ENVIDENT:VSEARCH_ASV_KRONA_(BOLD|MIDORI2):VSEARCH_ASV_LCA:VSEARCH' {
        ext.args = '--query_cov 0.9 --strand both --maxaccepts 50000 --maxrejects 1000 --maxhits 1000 --output_no_hits'
    }

    withName: '.*:KRONA_ALL' {
        ext.prefix = { "${meta.id}_lca_all" }
    }
    withName: '.*:KRONA_TOP' {
        ext.prefix = { "${meta.id}_lca_top" }
    }

    withName: 'ENVIDENT:TABIX_BGZIP' {
        ext.args = '--index'
        ext.prefix = { meta.table_name.replaceFirst(/\.[^.]+$/, '') }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/${meta.table_directory}" },
            mode: params.publish_dir_mode,
            failOnError: true,
            pattern: '*.{gz,gzi}',
            saveAs: { filename -> "${meta.table_name}.gz${filename.endsWith('.gzi') ? '.gzi' : ''}" }
        ]
    }

    withName: 'ENVIDENT:VSEARCH_ASV_KRONA_BOLD:LCA_KRONA_REPORTS:(KRONA_ALL|KRONA_TOP)' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/taxonomy-summary/${params.bold_label}" },
            mode: params.publish_dir_mode,
            failOnError: true,
            pattern: '*.html',
            saveAs: { filename ->
                def method = filename.startsWith("${meta.id}_lca_all") ? 'all_hits' : 'top_hits'
                def description = "krona_lca_${method}.html"
                "${meta.id}_${params.bold_label}_${description}"
            }
        ]
    }

    withName: 'ENVIDENT:VSEARCH_ASV_KRONA_MIDORI2:LCA_KRONA_REPORTS:(KRONA_ALL|KRONA_TOP)' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/taxonomy-summary/${params.midori2_label}" },
            mode: params.publish_dir_mode,
            failOnError: true,
            pattern: '*.html',
            saveAs: { filename ->
                def method = filename.startsWith("${meta.id}_lca_all") ? 'all_hits' : 'top_hits'
                def description = "krona_lca_${method}.html"
                "${meta.id}_${params.midori2_label}_${description}"
            }
        ]
    }

    withName: MULTIQC {
        ext.prefix = { "${meta.id}_multiqc_report" }
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            [
                path: { "${params.outdir}/${meta.id}/qc/" },
                mode: params.publish_dir_mode,
                failOnError: true,
                pattern: "*multiqc_report.html",
                saveAs: { filename ->
                    filename.equals('versions.yml') ? null : filename
                }
            ]
        ]
    }    
    
    withName: CUSTOM_DUMPSOFTWAREVERSIONS {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode,
            pattern: '*_versions.yml'
        ]
    }

}
