
/*
 * Example macbook config file
*/

profiles {

    macbook {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g) --platform linux/amd64'
    }
 
}

// https://www.nextflow.io/docs/latest/config.html#miscellaneous
// On a successful completion of a run all files in work directory are automatically deleted.
cleanup = true

params {

    // COI BOLD database
    run_coi_bold = true

    coi_bold_ref_db = "reference_databases/BOLD_COI_vsearch.udb"
    bold_label = "BOLD"

    // MIDORI2 database
    run_coi_midori2 = true

    coi_midori2_ref_db = "reference_databases/MIDORI2_COI_vsearch_0926.udb"
    midori2_label = "MIDORI2"

    // Standard primer library
    std_primer_library = "pimento_primers/"
    cutadapt_primers = "cutadapt_primers/"
    
    // COI hmm model
    pfam_coi_db = "pfam_db/COI.hmm"

}
