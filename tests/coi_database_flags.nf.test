nextflow_pipeline {
    name "COI database flags"
    script "main.nf"

    test("Enabled bold requires its reference path: bold") {
        when {
            params {
                run_coi_midori = false
                coi_bold_ref_db = null
                outdir = "$outputDir"
            }
        }
        then {
            assert !workflow.success
            assert workflow.stdout.join('\n').contains('--run_coi_bold requires --coi_bold_ref_db')
        }
    }

    test("Enabled midori requires its reference path: midori") {
        when {
            params {
                run_coi_bold = false
                coi_midori_ref_db = null
                outdir = "$outputDir"
            }
        }
        then {
            assert !workflow.success
            assert workflow.stdout.join('\n').contains('--run_coi_midori requires --coi_midori_ref_db')
        }
    }
}
