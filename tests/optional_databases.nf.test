nextflow_workflow {
    name "Optional reference database validation"
    script "../subworkflows/local/utils_nfcore_envident_pipeline/main.nf"
    workflow "PIPELINE_INITIALISATION"

    test("Validate midori2-only configuration") {
        when {
            params {
                input = "${projectDir}/assets/test-fixtures/samplesheets/test_samplesheet.csv"
                outdir = "$outputDir"
                pfam_coi_db = "${projectDir}/assets/test-fixtures/test-ref-dbs/COI.hmm"
                std_primer_library = "${projectDir}/assets/test-fixtures/test-ref-dbs/standard_primers"
                cutadapt_primers = "${projectDir}/assets/test-fixtures/test-ref-dbs/cutadapt_primers"
                COI_midori2_ref_db = "${projectDir}/assets/test-fixtures/test-ref-dbs/COI.fasta"
            }
            workflow {
                """
                input[0] = false
                input[1] = true
                input[2] = true
                input[3] = []
                input[4] = params.outdir
                input[5] = params.input
                """
            }
        }
        then {
            assert workflow.success
            assert workflow.out.samplesheet.size() > 0
        }
    }

    test("Validate bold-only configuration") {
        when {
            params {
                input = "${projectDir}/assets/test-fixtures/samplesheets/test_samplesheet.csv"
                outdir = "$outputDir"
                pfam_coi_db = "${projectDir}/assets/test-fixtures/test-ref-dbs/COI.hmm"
                std_primer_library = "${projectDir}/assets/test-fixtures/test-ref-dbs/standard_primers"
                cutadapt_primers = "${projectDir}/assets/test-fixtures/test-ref-dbs/cutadapt_primers"
                COI_bold_ref_db = "${projectDir}/assets/test-fixtures/test-ref-dbs/COI.fasta"
            }
            workflow {
                """
                input[0] = false
                input[1] = true
                input[2] = true
                input[3] = []
                input[4] = params.outdir
                input[5] = params.input
                """
            }
        }
        then {
            assert workflow.success
            assert workflow.out.samplesheet.size() > 0
        }
    }
}
