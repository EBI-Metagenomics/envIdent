            assert process.out.tsv[0][0] == [id: 'test', single_end: false]
            def summaries = asFiles(process.out.tsv[0][1])
            assert summaries.collect { path(it).getFileName().toString() }.sort() == ['test_first_pass_1_summ.tsv', 'test_first_pass_2_summ.tsv', 'test_second_pass_1_summ.tsv', 'test_second_pass_2_summ.tsv']
            summaries.each { file ->
                assert path(file).readLines() == ['Pre-primer length\tPrimer length\tPost-primer length\tRead count']
                assert path("${params.outdir}/test/primer-identification/${path(file).getFileName()}").exists()
            }
        }
    }
}
