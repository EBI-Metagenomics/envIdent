    test("Single reads: no_primers") {
        when {
            params { outdir = "$outputDir" }
            process {
                """
                input[0] = [[id: 'test', single_end: true], file('${projectDir}/modules/ebi-metagenomics/cutadapt/tests/data/reads_1.fastq'),
                    [file('${projectDir}/modules/ebi-metagenomics/cutadapt/tests/data/empty.fasta'), file('${projectDir}/modules/ebi-metagenomics/cutadapt/tests/data/empty_2.fasta'), file('${projectDir}/modules/ebi-metagenomics/cutadapt/tests/data/empty_3.fasta'), file('${projectDir}/modules/ebi-metagenomics/cutadapt/tests/data/empty_4.fasta')]]
                """
            }
        }
        then {
            assert process.success
            def asFiles = { value -> value instanceof List ? value : [value] }
            ['reads', 'log', 'json'].each { channel ->
                assert process.out[channel].size() == 1
                assert process.out[channel][0][0] == [id: 'test', single_end: true]
            }
            assert process.out.versions.size() == 1
            assert path(process.out.versions[0]).text.contains('cutadapt: 5.2')
            def reads = asFiles(process.out.reads[0][1]).sort()
            assert reads.collect { path(it).getFileName().toString() } == ['test.trim.fastq.gz']
            reads.each { assert path(it).size() == 0 }
            ['log', 'json'].each { channel ->
                assert asFiles(process.out[channel][0][1]).collect { path(it).getFileName().toString() }.sort() == ["test.first_pass.cutadapt.${channel}", "test.second_pass.cutadapt.${channel}"].collect { it.toString() }
                asFiles(process.out[channel][0][1]).each { file ->
                    if (channel == 'json') {
                        assert new groovy.json.JsonSlurper().parseText(path(file).text) ==
                            [message: 'No primers were inputted so trimming not performed']
                        assert path("${params.outdir}/test/primer-identification/${path(file).getFileName()}").text == path(file).text
                    } else {
                        assert path(file).size() == 0
                    }
                }
            }
            assert process.out.tsv.size() == 1
            assert process.out.tsv[0][0] == [id: 'test', single_end: true]
            def summaries = asFiles(process.out.tsv[0][1])
            assert summaries.collect { path(it).getFileName().toString() }.sort() == ['test_first_pass_se_summ.tsv', 'test_second_pass_se_summ.tsv']
            summaries.each { file ->
                assert path(file).readLines() == ['Pre-primer length\tPrimer length\tPost-primer length\tRead count']
                assert path("${params.outdir}/test/primer-identification/${path(file).getFileName()}").exists()
            }
        }
    }

