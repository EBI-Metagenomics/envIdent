nextflow_process {

    name "Test Process EXTRACT_CUTADAPT_PRIMERS"
    script "../main.nf"
    process "EXTRACT_CUTADAPT_PRIMERS"

    test("extract primers - fasta") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/modules/local/extract_cutadapt_primers/tests/data/test_forward_detected.fasta", checkIfExists: true),
                    file("${projectDir}/modules/local/extract_cutadapt_primers/tests/data/test_reverse_detected.fasta", checkIfExists: true)
                ]
                input[1] = file("${projectDir}/modules/local/extract_cutadapt_primers/tests/data/cutadapt_primer_library", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("extract primers - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/modules/local/extract_cutadapt_primers/tests/data/test_forward_detected.fasta", checkIfExists: true),
                    file("${projectDir}/modules/local/extract_cutadapt_primers/tests/data/test_reverse_detected.fasta", checkIfExists: true)
                ]
                input[1] = file("${projectDir}/modules/local/extract_cutadapt_primers/tests/data/cutadapt_primer_library", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}