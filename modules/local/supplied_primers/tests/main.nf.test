nextflow_process {

    name "Test Process SUPPLIED_PRIMERS"
    script "../main.nf"
    process "SUPPLIED_PRIMERS"

    tag "modules"
    tag "primer"

    test("supplied primers") {

        when {
            process {
                """
                input[0] = [
                    id: 'test',
                    single_end: false,
                    forward_primer: 'TTCTCAACCAACCANAANGANATNGG',
                    reverse_primer: 'ACWAAYCAYAAAGAYATYGG'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
