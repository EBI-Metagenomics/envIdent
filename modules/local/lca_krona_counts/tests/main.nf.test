nextflow_process {
    name "Test Process LCA_KRONA_COUNTS"
    script "../main.nf"
    process "LCA_KRONA_COUNTS"
    tag "modules"
    tag "lca_krona_counts"

    test("Aggregate read counts by lineage and retain unclassified ASVs") {
        when {
            process {
                """
                input[0] = [
                    [id: 'test'],
                    file('${projectDir}/modules/local/lca_krona_counts/tests/data/counts.tsv', checkIfExists: true),
                    file('${projectDir}/modules/local/lca_krona_counts/tests/data/all.tsv', checkIfExists: true),
                    file('${projectDir}/modules/local/lca_krona_counts/tests/data/top.tsv', checkIfExists: true)
                ]
                """
            }
        }
        then {
            assert process.success
            assert process.out.all_counts[0][0] == [id: 'test']
            assert process.out.top_counts[0][0] == [id: 'test']
            assert path(process.out.all_counts[0][1]).readLines() == [
                '9\td__\tk__Metazoa', '3\tUnclassified'
            ]
            assert path(process.out.top_counts[0][1]).readLines() == [
                '7\td__\tk__Metazoa\tp__Chordata',
                '2\td__\tk__Metazoa\tp__Arthropoda',
                '3\tUnclassified'
            ]
            ['all', 'top'].each { method ->
                def original = path("${projectDir}/modules/local/lca_krona_counts/tests/data/${method}.tsv").readLines()
                def counts = ['seq_1': 7, 'seq_2': 2, 'seq_3': 3]
                assert path(process.out["lca_${method}"][0][1]).readLines() == original.collect { row ->
                    "${row}\t${counts[row.split('\t')[0]] ?: 0}".toString()
                }
            }
            assert path(process.out.versions[0]).text.contains('node:')
        }
    }
}
